# Copy to .env on the BACKEND only. Never commit real values.
# The mobile app must never contain these keys.

# --- Supabase (auth + database) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=           # only for legacy HS256 projects; current projects use SUPABASE_URL (JWKS)
DATABASE_URL=                  # Supabase Postgres connection string (server-side only)

# --- Thunder Phone (calling + voice agent) ---
THUNDERPHONE_API_KEY=
THUNDERPHONE_WEBHOOK_SECRET=
THUNDERPHONE_FROM_NUMBER=      # E.164, an outbound-enabled number you own
THUNDERPHONE_AGENT_ID=         # optional saved agent; empty = inline config per call

# --- Switches ---
LIVE_CALLING_ENABLED=false

# --- Safety limits ---
MAX_CALL_SECONDS=300
DAILY_CALLS_PER_USER=20
CALL_WINDOW_START_HOUR=9
CALL_WINDOW_END_HOUR=21
CALL_TIMEZONE=Asia/Kolkata

# --- ThunderPhone agents (REQUIRED for live calls) ---
# Saved agents enforce the maximum call duration (agent setting max_call_duration_seconds) and carry the voice.
# Create one agent per voice you offer and map them. Inline per-call config cannot cap duration.
THUNDERPHONE_AGENT_MAP={"rohan":0,"kavita":0}
THUNDERPHONE_ALLOW_INLINE=false
